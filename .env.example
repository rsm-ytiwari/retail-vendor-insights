# Example .env variables (do NOT commit real credentials)
# Either set DATABASE_URL or the individual PG* variables below

# DATABASE_URL=postgresql://user:password@host:5432/dbname
PGUSER=your_user
PGPASSWORD=your_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=your_db

# Optional: choose behavior when loading (replace, append, fail)
IMPORT_IF_EXISTS=replace
